<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="8dp">

    <!-- DEVICE SCREEN -->
    <LinearLayout
        android:id="@+id/deviceScreenRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textStyle="bold"
            android:textSize="18sp"
            android:paddingBottom="6dp" />
        <Button
            android:id="@+id/purposeButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="Bond Single Watch"
            android:drawableEnd="@android:drawable/arrow_down_float" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pairing Mode:"
                android:textStyle="bold"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/connectionModeButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="BLE"
                android:drawableEnd="@android:drawable/arrow_down_float" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/gatewayScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:visibility="gone">
            <LinearLayout
                android:id="@+id/gatewayPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
        <LinearLayout
            android:id="@+id/bleStatusRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

        <TextView
            android:id="@+id/connection_status"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:text="NOT CONNECTED"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:background="@drawable/bg_chip_not_connected"
            android:textColor="@android:color/black"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/scanButton"
            android:layout_width="112dp"
            android:layout_height="48dp"
            android:background="@drawable/btn_gray"
            android:textColor="@android:color/white"
            android:text="Scan" />
        <ImageButton
            android:id="@+id/bleSettingsButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/btn_gray"
            android:src="@drawable/ic_watch_settings"
            android:padding="12dp"
            android:alpha="0.4"
            android:contentDescription="WearTAK watch settings"
            android:enabled="false" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/systemBondedPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/systemBondedWatchStatus"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:text="NOT CONNECTED"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:background="@drawable/bg_chip_not_connected"
                    android:textColor="@android:color/black"
                    android:layout_marginEnd="8dp" />

                <Button
                    android:id="@+id/systemBondedConnectButton"
                    android:layout_width="112dp"
                    android:layout_height="48dp"
                    android:background="@drawable/btn_gray"
                    android:textColor="@android:color/white"
                    android:text="Connect" />
            <ImageButton
                android:id="@+id/systemBondedSettingsButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/btn_gray"
                android:src="@drawable/ic_watch_settings"
                android:padding="12dp"
                android:alpha="0.4"
                android:contentDescription="WearTAK watch settings"
                android:enabled="false" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/garminPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/garminConnectionBadge"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:text="OFF"
                android:textColor="@android:color/white"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:background="@drawable/bg_chip_neutral"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/garminToggleButton"
                android:layout_width="112dp"
                android:layout_height="48dp"
                android:background="@drawable/btn_gray"
                android:textColor="@android:color/white"
                android:text="Retry" />
            <ImageButton
                android:id="@+id/garminSettingsButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/btn_gray"
                android:src="@drawable/ic_watch_settings"
                android:padding="12dp"
                android:alpha="0.4"
                android:contentDescription="WearTAK watch settings"
                android:enabled="false" />
        </LinearLayout>

        <TextView
            android:id="@+id/garminConnectionStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:text="Garmin Connect IQ is off."
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />

        </LinearLayout>

        <TextView
            android:id="@+id/emptyState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="10dp"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/deviceList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingTop="8dp" />

    </LinearLayout>

    <!-- ================= SETTINGS SCREEN (SCROLLABLE) ================= -->
    <ScrollView
        android:id="@+id/settingsScreenRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:fillViewport="true">

        <!-- ScrollView MUST have exactly one child -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/settingsBackButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Back" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="WearTAK Settings"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:gravity="center_vertical"
                    android:paddingLeft="10dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/settingsStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:text="" />

            <!-- Action buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/refreshSettingsButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Refresh from Watch" />

                <Button
                    android:id="@+id/sendSettingsButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Send to Watch" />
            </LinearLayout>

            <CheckBox
                android:id="@+id/phoneManagedSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Use WearTAK with this phone" />

            <TextView
                android:id="@+id/phoneManagedSettingsDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Use this phone's ATAK identity for the connected watch."
                android:paddingBottom="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="4dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Callsign"
                    android:alpha="0.85" />

                <EditText
                    android:id="@+id/watchCallsign"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="WEAROS-XYZ"
                    android:inputType="text"
                    android:singleLine="true" />
                </LinearLayout>

                <TextView
                    android:id="@+id/phoneTeam"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.5"
                    android:layout_marginStart="8dp"
                    android:text="Team (phone)\n—" />

                <TextView
                    android:id="@+id/phoneRole"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="Role (phone)\n—" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="4dp">

                <TextView
                    android:layout_width="110dp"
                    android:layout_height="wrap_content"
                    android:text="Report interval"
                    android:alpha="0.85" />

                <EditText
                    android:id="@+id/reportInterval"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="3"
                    android:inputType="number"
                    android:singleLine="true" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="sec"
                    android:layout_marginStart="8dp"
                    android:alpha="0.85" />
            </LinearLayout>

            <Button
                android:id="@+id/standaloneSetupButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Standalone Setup"
                android:contentDescription="Show standalone TAK server and P12 setup" />

            <LinearLayout
                android:id="@+id/serverSettingsGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Configure a TAK server and upload a P12 for standalone watch use. Send to Watch and wait for confirmation before disconnecting."
                    android:paddingBottom="8dp" />
                <!-- TAK Servers -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="TAK Servers"
                    android:textStyle="bold"
                    android:paddingTop="8dp"
                    android:paddingBottom="4dp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/takServerList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginTop="6dp">

                    <ImageButton
                        android:id="@+id/addServerButton"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:contentDescription="Add Server"
                        android:src="@drawable/ic_plus_circle"
                        android:background="@android:color/transparent"
                        android:padding="8dp" />

                </LinearLayout>
                <!-- Selected Server -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Selected Server"
                    android:textStyle="bold"
                    android:paddingTop="8dp"
                    android:paddingBottom="4dp" />

                <EditText
                    android:id="@+id/takName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Name" />

                <EditText
                    android:id="@+id/takAddress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Address (IP/DNS)" />

                <EditText
                    android:id="@+id/takPort"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Port"
                    android:inputType="number" />

                <CheckBox
                    android:id="@+id/takUseP12"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Authenticate with P12 certificate"
                    android:paddingTop="6dp" />

                <EditText
                    android:id="@+id/takUsername"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Username (if not P12)"
                    android:inputType="text" />

                <EditText
                    android:id="@+id/takPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Password (if not P12)"
                    android:inputType="textPassword" />

                <TextView
                    android:id="@+id/takP12Status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="6dp"
                    android:text="No certificate selected."
                    android:visibility="gone" />

                <EditText
                    android:id="@+id/takP12Password"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="P12 password"
                    android:inputType="textPassword"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/takP12Buttons"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <Button
                        android:id="@+id/chooseP12Button"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Choose P12 File" />

                    <Button
                        android:id="@+id/clearP12Button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Clear" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</FrameLayout>
