<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="8dp"
    android:layout_marginBottom="6dp"
    android:background="@drawable/bg_card">

    <TextView
        android:id="@+id/deviceName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="WT-WEAROS-1075"
        android:textSize="13sp"
        android:singleLine="false"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/deviceBondedName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:maxLines="2"
        android:ellipsize="end"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/deviceName"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/deviceMac"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="70:E3:48:AF:09:C9"
        android:textSize="12sp"
        android:alpha="0.8"
        android:maxLines="1"
        android:ellipsize="end"
        app:layout_constraintTop_toBottomOf="@id/deviceBondedName"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/rssiBadge"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:gravity="center"
        android:text="-63 dBm"
        android:textSize="11sp"
        android:textStyle="bold"
        android:background="@drawable/bg_chip_neutral"
        app:layout_constraintTop_toBottomOf="@id/deviceMac"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/deviceState"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="11sp"
        android:alpha="0.8"
        android:layout_marginStart="8dp"
        app:layout_constraintBaseline_toBaselineOf="@id/rssiBadge"
        app:layout_constraintStart_toEndOf="@id/rssiBadge"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/actionRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/rssiBadge"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/disconnectButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:minHeight="48dp"
            android:textSize="12sp"
            android:textAllCaps="false"
            android:text="Disconnect"
            android:visibility="gone" />

        <Button
            android:id="@+id/actionButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:minHeight="48dp"
            android:textSize="12sp"
            android:textAllCaps="false"
            android:text="Connect" />
        <ImageButton
            android:id="@+id/watchSettingsButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/btn_gray"
            android:src="@drawable/ic_watch_settings"
            android:padding="12dp"
            android:contentDescription="WearTAK watch settings"
            android:enabled="false"
            android:visibility="gone" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>